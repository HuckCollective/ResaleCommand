---
import Navbar from "@components/nav/Navbar.vue";
import Footer from "@components/Footer.astro";
import ToastContainer from "@components/ui/ToastContainer.vue";
import ConfirmContainer from "@components/ui/ConfirmContainer.vue";
import MarkdownModal from "@components/ui/MarkdownModal.astro";
import HuckleberryLoader from "@components/common/HuckleberryLoader.vue";
import { siteConfig } from "site-config";

import "../styles/global.css";
import SEOmeta from "@components/SEOmeta.astro";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  hideFooter?: boolean;
}

const { title = siteConfig.title, description, image, hideFooter = false } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="emerald">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />

    <SEOmeta title={title} description={description} image={image} />
    <script is:inline>
      const theme = localStorage.getItem('theme') || 'emerald';
      document.documentElement.setAttribute('data-theme', theme);
    </script>
  </head>
  <body>
    <div class="flex flex-col min-h-screen w-full max-w-full min-w-0 overflow-x-clip">
      <Navbar client:load />
      <main class="flex-1 w-full max-w-full min-w-0 relative">
        <div id="runtime-error-banner" class="hidden p-6 max-w-lg mx-auto my-8 bg-error/10 border border-error/30 rounded-2xl text-center space-y-3 shadow-lg z-50">
          <div class="text-3xl">⚠️</div>
          <h2 class="text-lg font-bold text-error">Something went wrong loading this view</h2>
          <p id="runtime-error-msg" class="text-xs opacity-80 font-mono break-words"></p>
          <div class="pt-2 flex justify-center gap-2">
            <button onclick="window.location.reload()" class="btn btn-sm btn-error text-white font-bold">Reload Page</button>
            <a href="/" class="btn btn-sm btn-ghost font-bold">Home</a>
          </div>
        </div>
        <slot />
      </main>
      {!hideFooter && <Footer />}
    </div>

    <MarkdownModal />
    <HuckleberryLoader client:only="vue" />
    <ToastContainer client:only="vue" />
    <ConfirmContainer client:only="vue" />
    <script is:inline>
      window.addEventListener('error', function(e) {
        if (!e) return;
        const banner = document.getElementById('runtime-error-banner');
        const msg = document.getElementById('runtime-error-msg');
        if (banner && msg) {
          banner.classList.remove('hidden');
          msg.textContent = e.message || 'An unexpected client error occurred.';
        }
      });
    </script>
    <script>
      import { initAuth } from "../lib/store";

      // Initialize auth state on client load
      initAuth();
    </script>
  </body>
</html>
