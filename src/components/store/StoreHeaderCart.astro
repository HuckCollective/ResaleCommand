---
// StoreHeaderCart.astro
// Public storefront header actions — links to Saved Favorites, Collective Info, and Member Sign In
// (never leaks shoppers to internal /cart sourcing tracker or raw tenantId).
---
<div class="flex items-center gap-2 sm:gap-2.5">
  <a
    href="/subsite?favorites=1"
    id="rc-store-saved-btn"
    class="btn btn-sm h-11 md:h-9 btn-ghost border border-base-300 rounded-xl font-bold gap-1.5"
    title="Filter catalog by your saved favorites"
  >
    <span class="text-error">❤️</span>
    <span>Saved</span>
  </a>

  <a
    href="/coop"
    class="btn btn-sm h-11 md:h-9 btn-ghost rounded-xl font-semibold hidden sm:inline-flex"
  >
    Collective Info
  </a>

  <a
    href="/login"
    class="btn btn-sm h-11 md:h-9 btn-outline rounded-xl font-bold"
  >
    Member Sign In
  </a>
</div>

<script is:inline>
  (function () {
    var btn = document.getElementById('rc-store-saved-btn');
    if (!btn) return;
    btn.addEventListener('click', function (ev) {
      if (window.location.pathname === '/subsite' || window.location.pathname === '/subsite/') {
        ev.preventDefault();
        window.dispatchEvent(new CustomEvent('rc-toggle-store-favorites'));
      }
    });
  })();
</script>
