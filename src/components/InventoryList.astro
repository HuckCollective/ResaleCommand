---
import InventoryViewHub from './inventory/InventoryViewHub.vue';
---

<InventoryViewHub client:only="vue">
  <div slot="fallback" class="w-full max-w-full min-w-0 min-h-[600px] space-y-4" aria-busy="true">
    <!-- Top Header + Search Bar Skeleton -->
    <div class="card bg-base-100 border border-base-300 shadow-xs p-3 sm:p-4 space-y-3">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
        <div class="flex items-center gap-2">
          <div class="skeleton h-8 w-36 rounded-xl"></div>
          <div class="skeleton h-6 w-20 rounded-full"></div>
        </div>
        <div class="flex items-center gap-2 flex-wrap">
          <div class="skeleton h-9 w-full sm:w-72 rounded-xl"></div>
          <div class="skeleton h-9 w-24 rounded-xl"></div>
          <div class="skeleton h-9 w-24 rounded-xl"></div>
        </div>
      </div>

      <!-- Spatial Bar Pills Skeleton (All | Storage | Selling) -->
      <div class="flex items-center gap-2 flex-wrap pt-1">
        <div class="skeleton h-8 w-24 rounded-full"></div>
        <div class="skeleton h-8 w-28 rounded-full"></div>
        <div class="skeleton h-8 w-28 rounded-full"></div>
        <div class="skeleton h-8 w-32 rounded-full"></div>
      </div>
    </div>

    <!-- 4-Card KPI Strip Skeleton -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
      <div class="skeleton h-20 w-full rounded-2xl"></div>
      <div class="skeleton h-20 w-full rounded-2xl"></div>
      <div class="skeleton h-20 w-full rounded-2xl"></div>
      <div class="skeleton h-20 w-full rounded-2xl"></div>
    </div>

    <!-- 8-Row Catalog Table Skeleton -->
    <div class="card bg-base-100 border border-base-300 shadow-xs p-3 space-y-2.5">
      <div class="skeleton h-9 w-full rounded-xl"></div>
      <div class="skeleton h-12 w-full rounded-xl"></div>
      <div class="skeleton h-12 w-full rounded-xl"></div>
      <div class="skeleton h-12 w-full rounded-xl"></div>
      <div class="skeleton h-12 w-full rounded-xl"></div>
      <div class="skeleton h-12 w-full rounded-xl"></div>
      <div class="skeleton h-12 w-full rounded-xl"></div>
      <div class="skeleton h-12 w-full rounded-xl"></div>
      <div class="skeleton h-12 w-full rounded-xl"></div>
    </div>
  </div>
</InventoryViewHub>
