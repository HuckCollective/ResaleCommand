---
import Layout from '../layouts/Layout.astro';
import DashboardShell from '../components/dashboard/DashboardShell.vue';
import { loadTaxPlaybookHtml } from '../lib/taxCms';

const taxPlaybookHtml = await loadTaxPlaybookHtml();
---

<Layout
  title="Example Works Hub | Works@TheHC"
  description="See what a worker-cooperative resale dashboard looks like for every kind of member. Example data only."
  hideFooter={true}
>
  <div class="rc-page-shell">
    <DashboardShell client:only="vue" mode="demo" taxPlaybookHtml={taxPlaybookHtml} />
  </div>
</Layout>


