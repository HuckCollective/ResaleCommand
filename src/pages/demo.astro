---
import Layout from '../layouts/Layout.astro';
import DashboardShell from '../components/dashboard/DashboardShell.vue';
import { loadRoleHelpHtmlMap, loadTaxPlaybookHtml } from '../lib/taxCms';

const [taxPlaybookHtml, roleHelpHtmlMap] = await Promise.all([
  loadTaxPlaybookHtml(),
  loadRoleHelpHtmlMap(),
]);
---

<Layout
  title="Example Works Hub | Works@TheHC"
  description="See what a worker-cooperative resale dashboard looks like for every kind of member. Example data only."
  hideFooter={true}
>
  <div class="rc-page-shell">
    <DashboardShell
      client:only="vue"
      mode="demo"
      taxPlaybookHtml={taxPlaybookHtml}
      roleHelpHtmlMap={roleHelpHtmlMap}
    />
  </div>
</Layout>



