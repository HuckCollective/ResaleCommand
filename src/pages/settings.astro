---
import Layout from '../layouts/Layout.astro';
import SettingsManager from '../components/settings/SettingsManager.vue';
---

<Layout title="Organization & Co-op Settings">
  <div class="rc-page-shell">
    <div>
      <div class="flex items-center gap-2 flex-wrap mb-1.5">
        <span class="badge badge-primary font-black text-xs px-2.5 py-1">Organization</span>
        <span class="badge badge-outline font-mono text-xs">1 Member = 1 Vote</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-base-content">Organization &amp; Co-op Settings</h1>
      <p class="text-xs sm:text-sm text-base-content/60 font-medium mt-1 max-w-2xl">
        Personas, barcode prefixes, consignor contracts, locations, team and hardware, all in one place.
      </p>
    </div>

    <SettingsManager client:only="vue" />
  </div>
</Layout>
