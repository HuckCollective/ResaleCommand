---
import ScoutContainer from "@components/scout/ScoutContainer.vue";
import Layout from "@layouts/Layout.astro";
---

<Layout title="Scout Tool | Resale Command" hideFooter={true}>
  <div class="container mx-auto px-2 sm:px-4 py-4 sm:py-6 pb-36">
    <div class="text-center mb-6">
      <h1 class="text-3xl sm:text-4xl font-extrabold bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent mb-1">
        Resale Scout
      </h1>
      <p class="text-sm sm:text-base opacity-70">
        AI-Powered Item Identification & Deal Management
      </p>
    </div>

    <ScoutContainer client:only="vue" />
  </div>
</Layout>
