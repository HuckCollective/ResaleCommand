---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Logging out...">
  <div class="flex min-h-screen items-center justify-center bg-base-100">
    <div class="text-center">
      <h2 class="text-2xl font-bold mb-4">Logging out...</h2>
      <span class="loading loading-spinner loading-lg text-primary"></span>
    </div>
  </div>
</Layout>

<script>
  import { logout } from "../lib/store";

  // Atomically clear Appwrite session, auth_session_indicator cookie, and rc_has_session hint.
  void logout();
</script>
