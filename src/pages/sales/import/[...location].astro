---
import Layout from '../../../layouts/Layout.astro';
import SalesImporter from '../../../components/sales/SalesImporter.vue';

const rawLocation = Astro.params.location || '';
const initialLocation = rawLocation.split('/').filter(Boolean)[0] || '';
---

<Layout title="Import Sales | Resale Command" hideFooter={true}>
  <div class="rc-page-shell">
    <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
      <h1 class="text-xl sm:text-2xl font-black tracking-tight text-base-content">Sales &amp; Payout Import</h1>
      <a href="/sales" class="btn btn-ghost btn-sm h-11 md:h-8 font-bold">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
        Back to Sales
      </a>
    </div>

    <SalesImporter initialLocation={initialLocation} client:only="vue" />
  </div>
</Layout>

