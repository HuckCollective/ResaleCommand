---
import Layout from '../../layouts/Layout.astro';
import SaleEditor from '../../components/sales/SaleEditor.vue';

export const prerender = false;
const { id } = Astro.params;
---

<Layout title="Edit Sale">
  <div class="p-8 max-w-5xl mx-auto space-y-8">
    <div class="flex items-center gap-4">
      <a href="/sales" class="btn btn-ghost btn-sm btn-circle">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
      </a>
      <h1 class="text-3xl font-bold">Edit Sale</h1>
    </div>
    
    <SaleEditor client:only="vue" :saleId="id" />
  </div>
</Layout>
