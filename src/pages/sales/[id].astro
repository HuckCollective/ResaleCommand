---
import Layout from '../../layouts/Layout.astro';
import SaleEditor from '../../components/sales/SaleEditor.vue';

export const prerender = false;
const { id } = Astro.params;
---

<Layout title="Sales Order Details | Resale Command">
  <div class="p-4 sm:p-6 lg:p-8 max-w-6xl mx-auto">
    <SaleEditor client:only="vue" saleId={id || ''} />
  </div>
</Layout>
