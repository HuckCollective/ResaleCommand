---
import Layout from '../../layouts/Layout.astro';
import PurchasesList from '../../components/purchases/PurchasesList.vue';
---

<Layout title="Purchases | Resale Command" hideFooter={true}>
  <div class="p-4 sm:p-6 md:p-8 max-w-7xl mx-auto space-y-6 pb-44">
    
    <!-- PAGE HEADER -->
    <div class="flex flex-col gap-1">
      <h1 class="text-3xl sm:text-4xl font-black text-base-content tracking-tight">Purchases & Inbound</h1>
      <p class="text-xs sm:text-sm text-base-content/70">Track incoming hauls, online auction orders, and unboxing intake.</p>
    </div>
    
    <PurchasesList client:load />
  </div>
</Layout>
