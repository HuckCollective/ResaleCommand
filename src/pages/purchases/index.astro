---
import Layout from '../../layouts/Layout.astro';
import PurchasesList from '../../components/purchases/PurchasesList.vue';
---

<Layout title="Purchases | Resale Command" hideFooter={true}>
  <div class="p-4 sm:p-6 md:p-8 max-w-7xl mx-auto space-y-6 pb-44">
    
    <!-- PAGE HEADER -->
    <div class="flex flex-col gap-1">
      <h1 class="text-3xl sm:text-4xl font-black text-base-content tracking-tight">Purchases & Inbound</h1>
      <p class="text-xs sm:text-sm text-base-content/70">Track incoming hauls, online auction orders, and unboxing intake.</p>
    </div>
    
    <PurchasesList client:load />

    <!-- TACTILE FIXED BOTTOM DOCK (MOBILE-FIRST ERGONOMIC CLUSTER) -->
    <div class="fixed bottom-0 inset-x-0 z-50 bg-base-100/90 backdrop-blur-md border-t border-base-300/80 px-4 py-3 pb-[calc(0.75rem+env(safe-area-inset-bottom,0px))] transition-all">
      <div class="max-w-2xl mx-auto flex items-center justify-between gap-2.5">
        
        <!-- Action 1: Speed Entry -->
        <a href="/purchases/speed-entry" 
           class="btn btn-sm sm:btn-md btn-warning text-warning-content font-extrabold flex-1 rounded-2xl shadow-xs active:scale-95 transition-all gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          <span class="text-xs sm:text-sm">Speed Entry</span>
        </a>

        <!-- Hero Center: Haul Intake Workstation -->
        <a href="/purchases/ingest" 
           class="btn btn-sm sm:btn-md btn-primary text-primary-content font-black flex-[1.4] rounded-2xl shadow-md active:scale-95 transition-all gap-2 tracking-wide">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m4 10M4 7v10l8 4" />
          </svg>
          <span class="text-xs sm:text-sm font-black">Haul Intake</span>
        </a>

        <!-- Action 3: New Manual PO (High Contrast) -->
        <a href="/purchases/new" 
           class="btn btn-sm sm:btn-md bg-base-200 hover:bg-base-300 text-base-content border border-base-content/20 font-extrabold flex-1 rounded-2xl shadow-xs active:scale-95 transition-all gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0 opacity-75" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
          </svg>
          <span class="text-xs sm:text-sm">New PO</span>
        </a>

      </div>
    </div>

  </div>
</Layout>
