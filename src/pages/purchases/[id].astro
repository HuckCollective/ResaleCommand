---
import Layout from '../../layouts/Layout.astro';
import PurchaseEditor from '../../components/purchases/PurchaseEditor.vue';

const { id } = Astro.params;
---

<Layout title="Edit Purchase">
  <div class="p-8 max-w-7xl mx-auto space-y-8">
    <div class="flex items-center gap-4">
      <a href="/purchases" class="btn btn-ghost btn-circle">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </a>
      <h1 class="text-3xl font-bold tracking-tight">Purchase Details</h1>
    </div>
    
    <PurchaseEditor purchaseId={id} client:only="vue" />
  </div>
</Layout>
