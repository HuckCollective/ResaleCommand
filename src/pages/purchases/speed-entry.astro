---
import Layout from '../../layouts/Layout.astro';
import SpeedEntryForm from '../../components/purchases/SpeedEntryForm.vue';
---

<Layout title="Speed Entry">
  <div class="rc-page-shell-narrow">
    <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
      <h1 class="text-xl sm:text-2xl font-black tracking-tight text-base-content">Speed Entry &amp; Receipt Scanner</h1>
      <a href="/purchases" class="btn btn-ghost btn-sm h-11 md:h-8 font-bold">
        ← Back to Purchases
      </a>
    </div>
    
    <SpeedEntryForm client:load />
  </div>
</Layout>
