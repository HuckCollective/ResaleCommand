---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Joining Team...">
  <div class="flex min-h-screen items-center justify-center bg-base-200 px-4 py-12 sm:px-6 lg:px-8">
    <div class="card w-full max-w-md bg-base-100 border border-base-300 shadow-2xl rounded-3xl">
      <div class="card-body p-6 sm:p-8 space-y-6 text-center">
        <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-base-content">Joining Team...</h1>
        <div id="join-loading" class="flex flex-col items-center justify-center gap-3 py-4">
          <div class="skeleton h-12 w-12 rounded-2xl"></div>
          <div class="skeleton h-4 w-48"></div>
        </div>
        <div id="join-error" class="hidden space-y-4">
          <div id="join-error-text" class="alert alert-error text-xs sm:text-sm font-semibold"></div>
          <div class="flex flex-wrap items-center justify-center gap-2 pt-1">
            <a href="/login" class="btn btn-primary btn-sm h-11 md:h-9 font-black text-primary-content rounded-xl">Sign In</a>
            <a href="/signup" class="btn btn-outline btn-sm h-11 md:h-9 font-bold rounded-xl">Request Fresh Invite</a>
          </div>
        </div>
        <div id="join-success" class="text-success hidden space-y-2">
          <p class="text-xl font-bold mb-2">Successfully joined <span id="join-team-name"></span>!</p>
          <p class="text-sm text-base-content/75 mb-4">Managed by: <span id="join-owners"></span></p>
          <p class="text-xs text-base-content/60 pt-2 border-t border-base-300">
            Operates under the <a href="/coop" target="_blank" class="text-primary font-bold underline">Huckleberry Collective Charter</a>
          </p>
          <p class="text-xs text-base-content/70">Redirecting to dashboard...</p>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { auth } from "../lib/auth";
  import { toUserMessage } from "../lib/userFacingErrors";

  const loadingEl = document.getElementById('join-loading') as HTMLElement;
  const errorEl = document.getElementById('join-error') as HTMLElement;
  const errorTextEl = document.getElementById('join-error-text') as HTMLElement;
  const successEl = document.getElementById('join-success') as HTMLElement;

  function showError(message: string) {
    if (errorTextEl) {
      errorTextEl.textContent = message;
    } else {
      errorEl.textContent = message;
    }
    errorEl.classList.remove('hidden');
    loadingEl.classList.add('hidden');
  }

  async function run() {
    const urlParams = new URLSearchParams(window.location.search);
    const teamId = urlParams.get('teamId');
    const membershipId = urlParams.get('membershipId');
    const userId = urlParams.get('userId');
    const secret = urlParams.get('secret');

    if (!teamId || !membershipId || !userId || !secret) {
      showError('Invalid invitation link.');
      return;
    }

    // Check if user is logged in
    const currentUser = await auth.getCurrentUser();
    if (!currentUser) {
      // Redirect to login preserving the current URL
      const redirectUrl = encodeURIComponent(window.location.href);
      window.location.href = `/login?redirect=${redirectUrl}`;
      return;
    }

    try {
      await auth.acceptInvite(teamId, membershipId, userId, secret);

      // Fetch Team Details to Show User
      const { teams } = await import('../lib/appwrite'); // Dynamic import to avoid top-level issues if any
      const team = await teams.get(teamId);
      (document.getElementById('join-team-name') as HTMLElement).textContent = team.name;

      // Fetch Owners
      const members = await teams.listMemberships(teamId);
      const owners = members.memberships.filter((m: any) => m.roles.includes('owner'));
      (document.getElementById('join-owners') as HTMLElement).textContent = owners
        .map((o: any) => o.userName || o.name || o.userEmail || o.email)
        .join(', ');

      loadingEl.classList.add('hidden');
      successEl.classList.remove('hidden');

      setTimeout(() => {
        window.location.href = '/';
      }, 3000);
    } catch (err: any) {
      console.error(err);
      showError(toUserMessage(err, 'Failed to join team. Your invitation link may have expired.'));
    }
  }

  run();
</script>
