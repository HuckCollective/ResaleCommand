---
import Layout from '../../../layouts/Layout.astro';
import LocationSyncView from '../../../components/warehouses/LocationSyncView.vue';

const rawLocation = Astro.params.location || '';
const initialLocation = rawLocation.split('/').filter(Boolean)[0] || '';
---

<Layout title="Location Inventory & Sales Sync" hideFooter={true}>
  <div class="p-4 md:p-8 max-w-[1600px] mx-auto pb-36 sm:pb-44">
    <LocationSyncView initialLocation={initialLocation} client:only="vue" />
  </div>
</Layout>

