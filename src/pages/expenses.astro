---
import Layout from '../layouts/Layout.astro';
import CoopSubNav from '../components/coop/CoopSubNav.vue';
import CoopExpensesLedger from '../components/coop/CoopExpensesLedger.vue';
---

<Layout
  title="Shared Commons & Personal Tax Expense Ledger | Resale Command"
  description="Audit-ready cooperative expense ledger, Personal Schedule C write-off separation, PDF invoice storage, and Tier 1 shared pool reimbursements."
  hideFooter={true}
>
  <div class="p-4 sm:p-6 md:p-8 max-w-7xl mx-auto space-y-6 pb-44 sm:pb-40">
    <CoopSubNav client:only="vue" activeTab="expenses" />
    <CoopExpensesLedger client:only="vue" />
  </div>
</Layout>
