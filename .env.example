# Appwrite Cloud Configuration
PUBLIC_APPWRITE_ENDPOINT=https://sfo.cloud.appwrite.io/v1
PUBLIC_APPWRITE_PROJECT_ID=your_appwrite_project_id_here
PUBLIC_APPWRITE_DB_ID=resale_db
PUBLIC_APPWRITE_COLLECTION_ID=items_dev
PUBLIC_APPWRITE_BUCKET_ID=item_images

# Secret Server Keys (Never share or commit with real values)
GEMINI_API_KEY=your_gemini_api_key_here
APPWRITE_API_KEY=your_appwrite_server_api_key_here

# Dev & Testing Collections
PUBLIC_APPWRITE_ALPHA_COLLECTION_ID=items_dev
PUBLIC_APPWRITE_PURCHASES_COLLECTION_ID=purchases_dev
PUBLIC_TEST_USER_EMAIL=test@example.com
PUBLIC_TEST_USER_PASSWORD=your_test_password_here
